{
  "name": "@prv/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript reference client for the Personal Records Vault Local Provider API (OpenAPI).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typegen": "openapi-typescript ../../spec/openapi/prv-local.openapi.yaml -o src/generated/openapi-types.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
